<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:DMXVideoPlayer"
		mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="580"
		x:Class="DMXVideoPlayer.AboutWindow"
		x:CompileBindings="False"
		Icon="avares://DM-X Video Player/Assets/DMX-Video-Player.ico"
		Title="{Binding [About_Title], Source={x:Static local:LocalizationService.Instance}}"
		Width="420" Height="500"
		WindowStartupLocation="CenterOwner"
		CanResize="False"
		Background="#2D2D2D">

	<Grid Margin="16">
		<StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
			<Image Source="avares://DM-X Video Player/Assets/DMX-Video-Player-128x128.png"
				   Width="96" Height="96"
				   HorizontalAlignment="Center"/>

			<TextBlock Text="{Binding [About_AppName], Source={x:Static local:LocalizationService.Instance}}"
					   Foreground="#FFFFFF"
					   FontWeight="Bold"
					   FontSize="18"
					   HorizontalAlignment="Center"/>

			<TextBlock Name="VersionTextBlock"
					   Text="Version 1.0.0"
					   Foreground="#999999"
					   FontSize="12"
					   HorizontalAlignment="Center"/>

			<TextBlock Name="AuthorTextBlock" Text="{Binding [About_Author], Source={x:Static local:LocalizationService.Instance}}"
					   Foreground="#DDDDDD"
					   FontSize="12"
					   HorizontalAlignment="Center"/>

			<TextBlock Text="{Binding [About_License], Source={x:Static local:LocalizationService.Instance}}"
					   Foreground="#DDDDDD"
					   FontSize="12"
					   HorizontalAlignment="Center"/>

			<Image Name="GitHubLinkImage"
				   Source="avares://DM-X Video Player/Assets/GitHub_Lockup_White.png"
				   Height="24"
				   HorizontalAlignment="Center"
				   Cursor="Hand"
				   ToolTip.Tip="{Binding [About_GitHubTooltip], Source={x:Static local:LocalizationService.Instance}}"/>

			<Rectangle Height="1" Fill="#444444" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>

			<TextBlock Text="{Binding [About_ShortcutsTitle], Source={x:Static local:LocalizationService.Instance}}"
					   Foreground="#FFFFFF"
					   FontWeight="Bold"
					   FontSize="14"
					   HorizontalAlignment="Center"/>

			<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
				<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [About_Shortcut_SpaceEnter], Source={x:Static local:LocalizationService.Instance}}" Foreground="#DDDDDD" FontSize="12" Margin="0,0,8,4"/>
				<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [About_Shortcut_PlayPause], Source={x:Static local:LocalizationService.Instance}}" Foreground="#999999" FontSize="12" Margin="0,0,0,4"/>

				<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [About_Shortcut_Zero], Source={x:Static local:LocalizationService.Instance}}" Foreground="#DDDDDD" FontSize="12" Margin="0,0,8,4"/>
				<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding [About_Shortcut_Stop], Source={x:Static local:LocalizationService.Instance}}" Foreground="#999999" FontSize="12" Margin="0,0,0,4"/>

				<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [About_Shortcut_LeftClick], Source={x:Static local:LocalizationService.Instance}}" Foreground="#DDDDDD" FontSize="12" Margin="0,0,8,4"/>
				<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding [About_Shortcut_PlayPause], Source={x:Static local:LocalizationService.Instance}}" Foreground="#999999" FontSize="12" Margin="0,0,0,4"/>

				<TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [About_Shortcut_DoubleLeftClick], Source={x:Static local:LocalizationService.Instance}}" Foreground="#DDDDDD" FontSize="12" Margin="0,0,8,4"/>
				<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding [About_Shortcut_ToggleFullscreen], Source={x:Static local:LocalizationService.Instance}}" Foreground="#999999" FontSize="12" Margin="0,0,0,4"/>

				<TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [About_Shortcut_MouseWheel], Source={x:Static local:LocalizationService.Instance}}" Foreground="#DDDDDD" FontSize="12" Margin="0,0,8,4"/>
				<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding [About_Shortcut_SeekVideo], Source={x:Static local:LocalizationService.Instance}}" Foreground="#999999" FontSize="12" Margin="0,0,0,4"/>

				<TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [About_Shortcut_ArrowKeys], Source={x:Static local:LocalizationService.Instance}}" Foreground="#DDDDDD" FontSize="12" Margin="0,0,8,4"/>
				<TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding [About_Shortcut_SeekVideo], Source={x:Static local:LocalizationService.Instance}}" Foreground="#999999" FontSize="12" Margin="0,0,0,4"/>

				<TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [About_Shortcut_P], Source={x:Static local:LocalizationService.Instance}}" Foreground="#DDDDDD" FontSize="12" Margin="0,0,8,4"/>
				<TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding [About_Shortcut_OpenSettings], Source={x:Static local:LocalizationService.Instance}}" Foreground="#999999" FontSize="12" Margin="0,0,0,4"/>

				<TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [About_Shortcut_I], Source={x:Static local:LocalizationService.Instance}}" Foreground="#DDDDDD" FontSize="12" Margin="0,0,8,0"/>
				<TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding [About_Shortcut_OpenAbout], Source={x:Static local:LocalizationService.Instance}}" Foreground="#999999" FontSize="12" Margin="0,0,0,0"/>
			</Grid>
		</StackPanel>
	</Grid>
</Window>
